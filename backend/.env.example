# Local SQLite file (default):
DATABASE_URL=sqlite:///./zoom_clone.db
# Turso (hosted SQLite): use the URL and token from `turso db show --url` / `turso db tokens create <db>`
# DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=<your-token>
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true
EMPTY_ROOM_GRACE_SECONDS=30
